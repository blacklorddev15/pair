{
    "name": "Astro Extra",
    "description": "Astro Extra WhatsApp session generator",
    "logo": "https://files.catbox.moe/ojo6av.jpg",
    "repository": "https://github.com/blacklorddev15/pair",
    "keywords": ["Astro Extra", "WhatsApp", "session"],
    "success_url": "/",
    "buildpacks": [{ "url": "https://github.com/heroku/heroku-buildpack-nodejs#latest" }],
    "env": {
        "PORT": {
            "description": "Port for the web app (Heroku sets this automatically)",
            "required": false
        },
        "SESSION_SECRET": {
            "description": "Secret key for session management",
            "generator": "secret",
            "required": false
        }
    }
}
